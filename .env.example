# HealRx Aesthetics & Laser Clinic — Environment Configuration
# Copy this file to .env or .env.local for local development overrides.
# Note: In Vite, only variables prefixed with VITE_ are exposed to the browser client.

# Primary Production Domain (Used for canonical URLs, Open Graph, and sitemaps)
VITE_SITE_URL=https://healrx.in

# Clinic Contact Information (Optional client-level overrides)
VITE_CLINIC_PHONE=+919372164224
VITE_CLINIC_EMAIL=contact@healrx.in
VITE_CLINIC_WHATSAPP=919372164224

# Third-Party Integrations (Optional)
# VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
# VITE_GOOGLE_MAPS_API_KEY=
